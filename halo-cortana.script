Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

bg_image = Image("background.png");
screen_ratio = Window.GetWidth() / Window.GetHeight();
bg_ratio = bg_image.GetWidth() / bg_image.GetHeight();

if (screen_ratio > bg_ratio) {
    bg_scale_factor = Window.GetWidth() / bg_image.GetWidth();
} else {
    bg_scale_factor = Window.GetHeight() / bg_image.GetHeight();
}

scaled_bg = bg_image.Scale(bg_image.GetWidth() * bg_scale_factor, bg_image.GetHeight() * bg_scale_factor);
bg_sprite = Sprite(scaled_bg);
bg_sprite.SetX(Window.GetWidth() / 2 - scaled_bg.GetWidth() / 2);
bg_sprite.SetY(Window.GetHeight() / 2 - scaled_bg.GetHeight() / 2);
bg_sprite.SetZ(-10000);

frame_count = 30;
for (i = 0; i < frame_count; i++) {
    frames[i] = Image("heart_" + i + ".png");
}

sprite = Sprite();
sprite.SetX(Window.GetWidth() / 2 - frames[0].GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - frames[0].GetHeight() / 2);
sprite.SetZ(10);

progress = 0;
fun refresh_callback () {
    progress++;
    frame = Math.Int(progress / 2) % frame_count;
    sprite.SetImage(frames[frame]);
}

Plymouth.SetRefreshFunction (refresh_callback);

# --- PROGRESS BAR IMPLEMENTATION ---
bar_max_width = 300;
bar_height = 4;

raw_bar_bg = Image("progress_bg.png");
raw_bar_fg = Image("progress_bar.png");

scaled_bar_bg = raw_bar_bg.Scale(bar_max_width, bar_height);

progress_bar_bg_sprite = Sprite(scaled_bar_bg);
progress_bar_bg_sprite.SetX(Window.GetWidth() / 2 - bar_max_width / 2);
progress_bar_bg_sprite.SetY(Window.GetHeight() / 2 + 190);
progress_bar_bg_sprite.SetZ(9999);

progress_bar_sprite = Sprite();
progress_bar_sprite.SetX(Window.GetWidth() / 2 - bar_max_width / 2);
progress_bar_sprite.SetY(Window.GetHeight() / 2 + 190);
progress_bar_sprite.SetZ(10000);

current_progress = 0.0;

fun boot_progress_callback (time, progress) {
    if (progress < 0.0) progress = 0.0;
    if (progress > 1.0) progress = 1.0;
    current_progress = progress;
    
    current_width = Math.Int(bar_max_width * current_progress);
    if (current_width < 1) current_width = 1;
    
    scaled_bar_fg = raw_bar_fg.Scale(current_width, bar_height);
    progress_bar_sprite.SetImage(scaled_bar_fg);
}

Plymouth.SetBootProgressFunction (boot_progress_callback);

# --- Password & Message Handlers ---
message_sprite = Sprite();
message_sprite.SetZ(10000);

# Jika teks status sistem (fsck/loading) tidak ingin menutupi progress bar,
# atau hanya ingin menampilkan pesan penting, kita posisikan teks tepat di atas progress bar
fun display_message_callback (text) {
    if (text) {
        my_image = Image.Text(text, 0.7, 0.9, 1.0); # Light blue Cortana color
        message_sprite.SetImage(my_image);
        message_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
        message_sprite.SetY(Window.GetHeight() / 2 + 160);
    } else {
        message_sprite.SetImage(null);
    }
}

prompt_sprite = Sprite();
prompt_sprite.SetZ(10000);

fun display_password_callback (prompt, bullets) {
    bullet_string = "";
    for (i = 0; i < bullets; i++) {
        bullet_string += "*";
    }
    text = prompt + " " + bullet_string;
    my_image = Image.Text(text, 0.8, 0.9, 1.0);
    prompt_sprite.SetImage(my_image);
    prompt_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
    prompt_sprite.SetY(Window.GetHeight() / 2 + 180);
}

fun display_normal_callback () {
    prompt_sprite.SetImage(null);
    message_sprite.SetImage(null);
}

Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetUpdateStatusFunction (display_message_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayNormalFunction (display_normal_callback);
